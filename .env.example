# Copy to .env and adjust. Every value has a working default in compose.yaml,
# so .env is only needed when a port is already taken locally.

# Host port this service publishes on.
FRONTEND_PORT=5602

# Where the other two services are reachable. These end up in the rendered
# config and in links the browser follows, so they must match the ports those
# stacks actually publish.
ISSUER_PORT=5600
OIDC_PORT=5601

# Flask reloader. 0 for quieter logs.
FLASK_DEBUG=1
