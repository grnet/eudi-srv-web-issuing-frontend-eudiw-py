# Template for frontend_config.yaml, rendered at deploy time.
#
# gfour's deploy-okeanos-v8 config with the deployment-specific URLs turned into
# placeholders. The Deploy workflow runs envsubst over it and passes
# the result to compose, which mounts it at /app/frontend_config.yaml.
#
# Safe to commit: the one secret, backend_api_key, is a placeholder filled from
# the ISSUER_BACKEND_API_KEY repository secret. The URLs are public, and
# frontend_id is an identifier the issuer already knows.
#
# backend_url is the public HTTPS URL, not a container name. This stack is
# deliberately standalone: the frontend has no internal/external URL pair the
# way the OIDC server does, so there is nothing to gain from sharing a private
# network with the issuer. 0.11.0 requires https here, as the key is sent to it.

service_url: "${FRONTEND_PUBLIC_URL}"
log_dir: "/tmp/logs/logs.log"

frontend_id: "5d725b3c-6d42-448e-8bfd-1eff1fcf152d"

backend_url: "${ISSUER_PUBLIC_URL}"

# Since 0.11.0 the frontend loads its metadata from the backend with this key
# (X-Api-Key). The same ISSUER_BACKEND_API_KEY secret is the backend's
# backend_api_key, in the issuer repository.
backend_api_key: "${ISSUER_BACKEND_API_KEY}"

# No credentials_supported and no oauth_url since 0.11.0: the backend decides
# which credentials this frontend advertises (frontend.frontends_config.<id>.
# credentials_supported in the issuer's config), and names its authorization
# server.
