# Non-secret deploy configuration, committed so it is reviewable in a diff.
# This stack has no secrets beyond the SSH key; see deploy/README.md.

FRONTEND_HOST=demo.eudiw.grnet.gr
FRONTEND_PATH=/frontend/

# What the frontend publishes about itself. It serves /.well-known/<service>
# under its own identity, so this is a credential issuer identifier rather than
# just a UI address. No trailing slash: the code concatenates "/..." onto it.
FRONTEND_PUBLIC_URL=https://demo.eudiw.grnet.gr/frontend

# The issuer and its authorization server, over the public URL rather than a
# container name. This stack is standalone on purpose: unlike the OIDC server,
# the frontend has no internal/external URL pair, so there is nothing to gain
# from sharing a private network with them.
ISSUER_PUBLIC_URL=https://demo.eudiw.grnet.gr/issuer
# Under the issuer, as upstream assumes: <issuer>/oidc. The app derives the
# same thing itself when rewriting metadata (app/__init__.py:268).
OIDC_PUBLIC_URL=https://${FRONTEND_HOST}/issuer/oidc

LETSENCRYPT_EMAIL=devops-rnd@grnet.gr
