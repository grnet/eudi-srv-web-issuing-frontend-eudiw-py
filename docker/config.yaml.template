# Local development configuration for the issuer frontend.
#
# A template, not the file the application reads: docker/entrypoint.sh renders
# the placeholders from the environment at container start, because the app's
# own loader is a plain yaml.safe_load() with no variable expansion
# (app/__init__.py:58).
#
# Only the three URLs differ between a laptop and a deployed host. The credential
# list below is identical everywhere and stays literal.

service_url: "${FRONTEND_PUBLIC_URL}"
log_dir: "/tmp/logs.log"

frontend_id: "5d725b3c-6d42-448e-8bfd-1eff1fcf152d"

backend_url: "${ISSUER_PUBLIC_URL}"
oauth_url: "${OIDC_PUBLIC_URL}"

credentials_supported:
    - "org.iso.18013.5.1.reservation_mdoc"
    - "eu.europa.ec.eudi.cor_mdoc"
    - "eu.europa.ec.eudi.diploma_vc_sd_jwt"
